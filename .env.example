# ProofHire AI Environment Variables
# Copy to .env and configure as needed

# Google Gemini API Key (Optional: Server auto-falls back to structured adaptive engine if missing)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Database URL (default: SQLite proofhire.db)
DATABASE_URL=sqlite:///./proofhire.db

# Backend Port
PORT=8000
