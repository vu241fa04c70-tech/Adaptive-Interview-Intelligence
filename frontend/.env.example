# ==========================================
# ProofHire AI — Frontend Environment Variables
# ==========================================

# When deploying the frontend separately (e.g. Vercel, Netlify):
# Set this to your deployed backend URL (WITHOUT trailing /api)
# Example: https://proofhire-ai.onrender.com
# Leave blank or omit when running locally or in unified container mode:
VITE_API_BASE_URL=
